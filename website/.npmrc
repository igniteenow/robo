# needed to prevent bad npm that has min-release-age but not exclude
engine-strict=true

min-release-age=14

# fast-uri 3.1.4 includes fixes for vulns. remove this when 3.1.4 is > 2wks  old
min-release-age-exclude[]=fast-uri

# minimatch 10.2.6 includes fixes for vulns. remove this when 10.2.6 is > 2wks  old
min-release-age-exclude[]=minimatch

# brace-expansion 5.0.8 includes fixes for vulns. remove this when 5.0.8 is > 2wks  old
min-release-age-exclude[]=brace-expansion

# dompurify 3.4.16 includes fixes for vulns (GHSA-p98j-92pf-mc4p). remove this when 3.4.16 is > 2wks old (after 2026-10-07)
min-release-age-exclude[]=dompurify

# 2026-10 dependency audit: security fixes released inside the 14-day window.
# Remove each when its release is > 2wks old (after 2026-11-06):
#   serialize-javascript 7.1.3 (XSS via unescaped </script>), body-parser 1.20.9
#   (DoS via trailing bytes), undici 7.30.1 (13 advisories), postcss-selector-parser.
min-release-age-exclude[]=serialize-javascript
min-release-age-exclude[]=body-parser
min-release-age-exclude[]=undici
min-release-age-exclude[]=postcss-selector-parser
